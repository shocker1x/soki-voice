# Core app settings
APP_ENV=development
APP_DATA_DIR=./data
DATABASE_URL=sqlite:///./data/voice_traces.db
VOICE_MOCK_MODE=true

# LiveKit (required for real agent mode later)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# STT / TTS providers (required for real pipeline later)
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
ANTHROPIC_API_KEY=

# Optional: public frontend URL for browser demo or dashboard
PUBLIC_BASE_URL=http://127.0.0.1:8000
