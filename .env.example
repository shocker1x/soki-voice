# Core app settings
APP_ENV=development
APP_DATA_DIR=./data
DATABASE_URL=sqlite:///./data/voice_traces.db

# Set false to run the LiveKit worker instead of mock mode.
VOICE_MOCK_MODE=true

# LiveKit Cloud or self-hosted server
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Provider credentials required by the LiveKit worker
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
ANTHROPIC_API_KEY=

# Optional: public frontend URL for browser demo or dashboard
PUBLIC_BASE_URL=http://127.0.0.1:8000
